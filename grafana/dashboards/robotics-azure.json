{
  "uid": "robotics-azure",
  "title": "Robotics on Azure (Container Apps)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["robotics", "azure"],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "azure-monitor" },
      "targets": [{
        "refId": "A", "queryType": "Azure Monitor",
        "azureMonitor": {
          "resources": [{ "subscription": "058fa6f0-94a9-4e5c-9bf4-bbeebad075b2", "resourceGroup": "rg-marso-dev-99ff", "metricNamespace": "microsoft.app/containerapps", "resourceName": "ca-robotics-dev-99ff" }],
          "metricNamespace": "microsoft.app/containerapps", "metricName": "Requests", "aggregation": "Total", "timeGrain": "auto",
          "dimensionFilters": [{ "dimension": "statusCodeCategory", "operator": "eq", "filters": ["*"] }]
        }
      }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Active replicas (0 = scaled to zero)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "azure-monitor" },
      "targets": [{
        "refId": "A", "queryType": "Azure Monitor",
        "azureMonitor": {
          "resources": [{ "subscription": "058fa6f0-94a9-4e5c-9bf4-bbeebad075b2", "resourceGroup": "rg-marso-dev-99ff", "metricNamespace": "microsoft.app/containerapps", "resourceName": "ca-robotics-dev-99ff" }],
          "metricNamespace": "microsoft.app/containerapps", "metricName": "Replicas", "aggregation": "Maximum", "timeGrain": "auto"
        }
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "CPU (nanocores)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "azure-monitor" },
      "targets": [{
        "refId": "A", "queryType": "Azure Monitor",
        "azureMonitor": {
          "resources": [{ "subscription": "058fa6f0-94a9-4e5c-9bf4-bbeebad075b2", "resourceGroup": "rg-marso-dev-99ff", "metricNamespace": "microsoft.app/containerapps", "resourceName": "ca-robotics-dev-99ff" }],
          "metricNamespace": "microsoft.app/containerapps", "metricName": "UsageNanoCores", "aggregation": "Average", "timeGrain": "auto"
        }
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Memory working set", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "azure-monitor" },
      "targets": [{
        "refId": "A", "queryType": "Azure Monitor",
        "azureMonitor": {
          "resources": [{ "subscription": "058fa6f0-94a9-4e5c-9bf4-bbeebad075b2", "resourceGroup": "rg-marso-dev-99ff", "metricNamespace": "microsoft.app/containerapps", "resourceName": "ca-robotics-dev-99ff" }],
          "metricNamespace": "microsoft.app/containerapps", "metricName": "WorkingSetBytes", "aggregation": "Average", "timeGrain": "auto"
        }
      }]
    },
    {
      "id": 5, "type": "table", "title": "Recent application logs (non-health)", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "azure-monitor" },
      "targets": [{
        "refId": "A", "queryType": "Azure Log Analytics",
        "azureLogAnalytics": {
          "resources": ["/subscriptions/058fa6f0-94a9-4e5c-9bf4-bbeebad075b2/resourceGroups/rg-marso-dev-99ff/providers/Microsoft.OperationalInsights/workspaces/log-marso-dev-99ff"],
          "query": "ContainerAppConsoleLogs_CL | where ContainerAppName_s startswith 'ca-robotics' and Log_s !has 'api/health' | project TimeGenerated, Log_s | order by TimeGenerated desc | take 100",
          "resultFormat": "table"
        }
      }]
    }
  ]
}
